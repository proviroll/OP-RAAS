FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    cmake \
    clang \
    lldb \
    lld \
    libssl-dev \
    wget \
    bc \
    jq \
    direnv \
    software-properties-common \
    make \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* && \
    pip3 install awscli

# Install Go 1.21.6
RUN wget https://go.dev/dl/go1.21.6.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.21.6.linux-amd64.tar.gz && \
    rm go1.21.6.linux-amd64.tar.gz
ENV PATH=$PATH:/usr/local/go/bin

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Install pnpm
RUN npm install -g pnpm@8.15.9

# Install Foundry
RUN curl -L https://foundry.paradigm.xyz | bash && \
    export PATH="$PATH:$HOME/.foundry/bin" && \
    /root/.foundry/bin/foundryup
ENV PATH=$PATH:/root/.foundry/bin

WORKDIR /app

# Clone and setup optimism
RUN git clone https://github.com/ethereum-optimism/optimism.git && \
    cd optimism && \
    git checkout tutorials/chain && \
    pnpm install 

# Create necessary directories
RUN mkdir -p /app/op-geth /app/op-cache /app/.deployer

# Copy scripts
COPY scripts/setup-optimism.sh /app/setup-optimism.sh
COPY scripts/deploy-rollup.sh /app/deploy-rollup.sh
COPY scripts/deployer-entrypoint.sh /app/entrypoint.sh

# Make scripts executable
RUN chmod +x /app/*.sh

ENTRYPOINT ["/app/entrypoint.sh"] 